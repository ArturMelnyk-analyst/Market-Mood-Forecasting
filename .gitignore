# ============================================================
# Market Mood Forecasting - Git ignore rules
# ============================================================
#
# Protect local environments, credentials, licensed data,
# generated artifacts, and temporary files.
#
# Preserve explicitly approved artifacts used by the
# stable Market Mood Forecasting v1.2.0 project.
#
# ES Daily Forward Experiment v0.1:
# Source notebooks and documentation may be committed
# after review. Purchased Databento data and generated
# modeling artifacts must remain local.
# ============================================================


# ================================
# Data - existing project files
# ================================

!/data/.gitkeep
!/data/cleaned/**


# ================================
# ES daily: default-deny new raw files
# ================================
# Keep the four legacy public datasets eligible for tracking.
# These four files were already tracked by Git as of 2026-11-11.
# Other new raw files (including licensed Databento and original
# Arena HTML) require a separate rights/privacy review.
# Gitignore does not untrack any file already in Git history.

/data/raw/*
!/data/raw/google_trends.csv
!/data/raw/sp500_data.csv
!/data/raw/unrate_data.csv
!/data/raw/vix_data.csv


# ================================
# Databento - licensed raw data
# ================================
#
# Historical DBN files, purchase/job artifacts,
# and other locally acquired Databento inputs
# must not be committed to the public repository.
#
# This rule applies recursively to the directory.
# ================================

/data/raw/databento/


# ================================
# Generated processed data
# ================================
#
# Notebook 08 creates files such as:
#
# es_arena_alignment_v0_1.csv
# es_raw_manifest_v0_1.csv
# es_daily_modeling_v0_1.parquet
# es_daily_modeling_v0_1_metadata.json
#
# Keep these local until redistribution rights
# and any sensitive contents are reviewed.
#
# Existing tracked files, if any, are not
# automatically removed by this ignore rule.
# ================================

/data/processed/


# ================================
# ES daily: private evidence/archives
# ================================
# Includes research CSV backups, timestamped evidence, and
# historical notebooks with execution outputs.
# Use explicit 'git add <reviewed path>' for public source code.

/backups/
/archive/
/notebooks/archive/
/tools/archive/
/arena_nov_2026_backfill/evidence/
/arena_nov_2026_backfill/peer_revision_history_audit.json
/arena_nov_2026_backfill/source_manifest.json


# ================================
# Feature-engineered data
# ================================
#
# Preserve existing stable-project behavior.
# ================================

/data/feature_engineered/**

!/data/feature_engineered/fe_dataset_v1_1.csv


# ================================
# Models
# ================================
#
# Preserve existing v1.2.0 model-artifact rules.
# ================================

/models/**

!/models/.gitkeep
!/models/logreg_pipeline_v1_1_1775664292.joblib
!/models/logreg_pipeline_v1_1_1775664292.json
!/models/logreg_coeff_importance_v1_1.csv
!/models/model_compare_v1_1.csv
!/models/permutation_importance_v1_1.csv
!/models/shap_importance_v1_1.csv
!/models/shap_top10_v1_1.csv
!/models/tscv_auc_folds_v1_1.csv
!/models/tscv_auc_summary_v1_1.csv


# ================================
# ES daily: notebooks held back from publication
# ================================
# The primary executed v0.3.2 notebook contains local audit
# outputs. Only publish its manually sanitized '_public' copy.
# Notebook 13 is preliminary paper-trading/ROI work, not part
# of the frozen M1 model-evaluation release.
# Notebook 11 is already tracked and MUST be reviewed separately;
# an ignore rule cannot protect tracked changes.

/notebooks/12_es_arena_prospective_evaluation_v0_3_2_separated_evaluation_and_provenance.ipynb
/notebooks/13_es_arena_paper_trading_roi_v0_1.ipynb


# ================================
# Virtual environments and secrets
# ================================

venv/
.venv/

.env
.env.*
*.env
!.env.example
.envrc
/secrets/
/credentials/

# Additional downloaded vendor data should not be staged.
*.dbn
*.dbn.zst


# ================================
# Jupyter checkpoints and temp files
# ================================

.ipynb_checkpoints/
*.ipynb~


# ================================
# Python bytecode and caches
# ================================

__pycache__/
*.py[cod]
*.so


# ================================
# Editors
# ================================

.vscode/
.idea/


# ================================
# System files
# ================================

.DS_Store
Thumbs.db


# ================================
# Logs and temporary files
# ================================

*.log
*.tmp
*.bak


# ================================
# Hugging Face configurations
# ================================

/.huggingface/*
!.huggingface/config_template.json


# ================================
# Hugging Face autogenerated files
# ================================

.gitattributes
space.yaml
